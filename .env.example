# Copy to .env.local and fill in. All services have free tiers.

# Upstash Redis — powers the real request counter (/api/health) and the
# token-bucket rate limiters (/api/demo/rate-limit, /api/contact).
# Create a database at https://console.upstash.com and copy the REST creds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend — powers contact-form email delivery (/api/contact).
# Get a key at https://resend.com. Until a domain is verified you can send
# from onboarding@resend.dev to your own inbox.
RESEND_API_KEY=
CONTACT_TO_EMAIL=anichandan124@gmail.com
