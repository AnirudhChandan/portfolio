# Copy to .env.local and fill in. All services have free tiers.

# Upstash Redis — powers the real request counter (/api/health) and the
# token-bucket rate limiters (/api/demo/rate-limit).
# Create a database at https://console.upstash.com and copy the REST creds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
